<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:InsigniaConsultoresApp"
             xmlns:converters="clr-namespace:InsigniaConsultoresApp.Converters"
             x:Class="InsigniaConsultoresApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/BrandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Convertidores de valor reutilizables. -->
            <converters:InvertedBoolConverter x:Key="InvertedBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
