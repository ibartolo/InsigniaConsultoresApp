<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InsigniaConsultoresApp.Views.CampaignDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle de campaña"
    BackgroundColor="{StaticResource BrandBackground}">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,28" Spacing="18">

                <!-- Encabezado -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Detalle de campaña" Style="{StaticResource BrandTitle}" />
                    <Label
                        Text="{Binding Campaign.Nombre}"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{StaticResource BrandPrimary}" />
                </VerticalStackLayout>

                <!-- Descripción: área amplia de solo lectura para poder leer el mensaje completo -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Descripción" Style="{StaticResource BrandFieldLabel}" />
                    <Border Style="{StaticResource BrandReadOnlyField}" HeightRequest="230">
                        <ScrollView>
                            <Label
                                Text="{Binding Campaign.Descripcion}"
                                Style="{StaticResource BrandReadOnlyText}" />
                        </ScrollView>
                    </Border>
                </VerticalStackLayout>

                <!-- Asunto -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Asunto" Style="{StaticResource BrandFieldLabel}" />
                    <Border Style="{StaticResource BrandReadOnlyField}">
                        <Label
                            Text="{Binding Campaign.Asunto}"
                            Style="{StaticResource BrandReadOnlyText}" />
                    </Border>
                </VerticalStackLayout>

                <!-- Estatus -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Estatus" Style="{StaticResource BrandFieldLabel}" />
                    <Border Style="{StaticResource BrandReadOnlyField}">
                        <Label
                            Text="{Binding Campaign.EstatusTexto}"
                            Style="{StaticResource BrandReadOnlyText}" />
                    </Border>
                </VerticalStackLayout>

                <!-- Fechas -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Label Grid.Row="0" Grid.Column="0" Text="Fecha de inicio" Style="{StaticResource BrandFieldLabel}" />
                    <Label Grid.Row="0" Grid.Column="1" Text="Fecha de fin" Style="{StaticResource BrandFieldLabel}" />

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource BrandReadOnlyField}">
                        <Label
                            Text="{Binding Campaign.FechaInicio, StringFormat='{0:dd/MM/yyyy}'}"
                            Style="{StaticResource BrandReadOnlyText}" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource BrandReadOnlyField}">
                        <Label
                            Text="{Binding Campaign.FechaFin, StringFormat='{0:dd/MM/yyyy}'}"
                            Style="{StaticResource BrandReadOnlyText}" />
                    </Border>
                </Grid>

                <!-- Totales -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Label Grid.Row="0" Grid.Column="0" Text="Total" Style="{StaticResource BrandFieldLabel}" />
                    <Label Grid.Row="0" Grid.Column="1" Text="Enviados" Style="{StaticResource BrandFieldLabel}" />
                    <Label Grid.Row="0" Grid.Column="2" Text="Pendientes" Style="{StaticResource BrandFieldLabel}" />

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource BrandReadOnlyField}">
                        <Label Text="{Binding Campaign.Total}" Style="{StaticResource BrandReadOnlyText}" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource BrandReadOnlyField}">
                        <Label Text="{Binding Campaign.Enviados}" Style="{StaticResource BrandReadOnlyText}" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource BrandReadOnlyField}">
                        <Label Text="{Binding Campaign.Pendientes}" Style="{StaticResource BrandReadOnlyText}" />
                    </Border>
                </Grid>

                <Button
                    Text="Comenzar campaña"
                    Command="{Binding StartCampaignCommand}"
                    Style="{StaticResource BrandButton}"
                    Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Cargando -->
        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource BrandOrange}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <!-- Error -->
        <Label
            Text="{Binding ErrorMessage}"
            IsVisible="{Binding HasError}"
            TextColor="#c53030"
            FontSize="14"
            Padding="24"
            HorizontalTextAlignment="Center"
            VerticalOptions="Center" />

    </Grid>

</ContentPage>
