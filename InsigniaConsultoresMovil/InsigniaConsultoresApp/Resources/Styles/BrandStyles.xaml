<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Tipografía de marca ===== -->

    <Style x:Key="BrandLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandTextBody}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="BrandTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- ===== Entrada de texto (sin caja) ===== -->
    <!-- Diseño "boxless": el Entry no lleva fondo, borde, caja ni placeholder.
         La etiqueta va arriba (BrandFieldLabel) y la separación visual es solo
         una línea inferior (BoxView de 1px #dde5ee → 2px #E8952B en foco). -->

    <Style x:Key="BrandFieldLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="BrandEntry" TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource BrandTextBody}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <!-- ===== Botones de marca ===== -->
    <!-- CTA naranja (gradiente #E8952B → #C97A18). MAUI Button admite Background
         (Brush) con gradiente; el ActivityIndicator se superpone en un Grid overlay. -->

    <Style x:Key="BrandButton" TargetType="Button">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource BrandOrange}" Offset="0.0" />
                    <GradientStop Color="{StaticResource BrandOrangeDark}" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#E8952B" Offset="0,6" Radius="18" Opacity="0.35" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BrandPrimaryButton" TargetType="Button">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="MinimumHeightRequest" Value="52" />
    </Style>

</ResourceDictionary>
